# GLITCH HUNT - Production Backend Environment Variables
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Security (Required: set a strong random secret in production)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION
ADMIN1_PASSWORD=CHANGE_THIS_MASTER_ADMIN_PASSWORD
ADMIN2_PASSWORD=CHANGE_THIS_CONTROLLER_PASSWORD

# Database
DB_PATH=./backend/database/glitch_hunt.sqlite

# Allowed Production Frontend Origin (CORS and Socket.IO)
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.com
